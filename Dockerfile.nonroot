# ---------- Stage 1 : Build ----------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore
RUN dotnet publish --configuration Release -o /app/publish

# ---------- Stage 2 : Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# Créer un utilisateur "appuser" sans shell de login
RUN useradd -r -s /bin/false appuser

WORKDIR /app

# Copier les fichiers avec le bon propriétaire
COPY --from=build --chown=appuser /app/publish .

# Basculer vers l'utilisateur non-root
USER appuser

ENTRYPOINT ["dotnet", "HelloNonRoot.dll"]
